PORT=3000
# Replicate API: Token nur serverseitig hinterlegen
REPLICATE_API_TOKEN=
# Versions-ID des gewünschten Replicate-Musikmodells
REPLICATE_MODEL_VERSION=
# Modellabhängig: z.B. prompt oder text
REPLICATE_INPUT_PROMPT_KEY=prompt
# Optionales JSON-Objekt mit zusätzlichen Modellparametern
REPLICATE_EXTRA_INPUT_JSON={}
